{
  "name": "react-native-accurate-location",
  "version": "1.0.0",
  "description": "Native module to get high accuracy device location for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-accurate-location.podspec",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "bob build",
    "clean": "del-cli lib"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "location",
    "gps",
    "geolocation",
    "turbomodule"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudci/react-native-accurate-location.git"
  },
  "bugs": {
    "url": "https://github.com/fudci/react-native-accurate-location/issues"
  },
  "homepage": "https://github.com/fudci/react-native-accurate-location#readme",
  "author": "myworkspace <dev@myworkspace.com>",
  "license": "MIT",
  "codegenConfig": {
    "name": "AccurateLocationSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.myworkspace.accuratelocation"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.86.1",
    "del-cli": "^7.0.0",
    "react": "^19.2.8",
    "react-native": "^0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.8.3"
  }
}
