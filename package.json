{
  "name": "react-native-accurate-location",
  "version": "1.0.0",
  "description": "Native module to get high accuracy device location for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-accurate-location.podspec",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "bob build",
    "clean": "del-cli lib",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "location",
    "gps",
    "geolocation",
    "turbomodule"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fudci/react-native-accurate-location.git"
  },
  "bugs": {
    "url": "https://github.com/fudci/react-native-accurate-location/issues"
  },
  "homepage": "https://github.com/fudci/react-native-accurate-location#readme",
  "author": "fudci <as.andisusilo@gmail.com>",
  "license": "MIT",
  "codegenConfig": {
    "name": "AccurateLocationSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.fudci.accuratelocation"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@react-native/babel-preset": "^0.86.1",
    "@react-native/eslint-config": "^0.86.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "commitlint": "^19.6.0",
    "del-cli": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "lefthook": "^1.10.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-native": "^0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.8.3"
  },
  "workspaces": [
    "example"
  ]
}
